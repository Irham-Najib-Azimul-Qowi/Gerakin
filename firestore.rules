rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Keamanan Koleksi /users/{userId}
    // Hanya pengguna terautentikasi pemilik dokumen yang diizinkan untuk membaca dan menulis data mereka.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subkoleksi workflows ( workouts / latihan / gerakan )
      match /workouts/{workoutId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Subkoleksi sessions ( riwayat latihan fisik )
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Subkoleksi analytics ( ringkasan & tren )
      match /analytics/{analyticsId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Subkoleksi settings ( preferensi audio, tts, tema )
      match /settings/{settingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Subkoleksi assessment ( uji fisik / mobilitas )
      match /assessment/{assessmentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Modul Community Rules ─────────────────────────────────────────
    // Postingan Komunitas: Pengguna terautentikasi dapat membaca & membuat postingan.
    match /community_posts/{postId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.authorUid == request.auth.uid;
    }

    // Komentar Komunitas: Pengguna terautentikasi dapat membaca & menulis komentar.
    match /community_comments/{commentId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.authorUid == request.auth.uid;
    }

    // Laporan Konten Komunitas: Pengguna terautentikasi dapat mengirim laporan.
    match /content_reports/{reportId} {
      allow create: if request.auth != null;
    }
  }
}
